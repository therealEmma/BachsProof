{
  "name": "@payproof/cli",
  "version": "1.1.0",
  "description": "CLI for black-box and controlled-concurrency payment correctness testing",
  "type": "module",
  "bin": {
    "payproof": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "engines": { "node": ">=22" },
  "scripts": { "build": "tsup" },
  "dependencies": {
    "@payproof/bachs": "workspace:*",
    "@payproof/core": "workspace:*",
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
