{
  "name": "@bachsproof/cli",
  "version": "1.1.0",
  "description": "CLI for BachsProof financial correctness testing",
  "keywords": [
    "payments",
    "payment-testing",
    "webhooks",
    "concurrency",
    "cli",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/therealEmma/BachsProof.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/therealEmma/BachsProof#readme",
  "bugs": {
    "url": "https://github.com/therealEmma/BachsProof/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "bachsproof": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "scripts": { "build": "tsup" },
  "dependencies": {
    "@bachsproof/bachs": "workspace:*",
    "@bachsproof/core": "workspace:*",
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
