{
  "name": "@bachsproof/reference-wallet",
  "version": "2.0.0",
  "private": true,
  "description": "Express 5 reference wallet for BachsProof scenarios",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "tsup",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate:deploy": "prisma migrate deploy",
    "start": "node dist/server.js"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@bachs/sdk": "^2.0.0",
    "@prisma/client": "^6.8.2",
    "express": "^5.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@bachsproof/bachs": "workspace:*",
    "@bachsproof/core": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "prisma": "^6.8.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
